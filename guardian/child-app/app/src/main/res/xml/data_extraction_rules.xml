<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the device token: a restored copy on another
     phone must not inherit this device's connection. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
